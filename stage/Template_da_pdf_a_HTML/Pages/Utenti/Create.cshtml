@page
@model Template_da_pdf_a_HTML.Pages.Utenti.CreateModel

@{
    ViewData["Title"] = "Create";
}

<center>
    <h1>Aggiungi Utente</h1>
</center>

<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <center>
                <h3>Dati Utente</h3>
            </center>
            <div class="form-group">
                <label asp-for="Utente.Nome" class="control-label"></label>
                <input asp-for="Utente.Nome" class="form-control" />
                <span asp-validation-for="Utente.Nome" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Utente.Cognome" class="control-label"></label>
                <input asp-for="Utente.Cognome" class="form-control" />
                <span asp-validation-for="Utente.Cognome" class="text-danger"></span>
            </div>
            <div class="form-group">
                Data Nascita
                <input asp-for="Utente.DataNascita" type="date" class="form-control" />
                <span asp-validation-for="Utente.DataNascita" class="text-danger"></span>
            </div>
            <br>
            <div class="form-group">
                <input type="submit" value="Next" class="btn btn-primary" /> |
                <a href="./Index" class="btn btn-secondary">Torna indietro</a>
            </div>
        </form>
    </div>
</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
