@page
@model Template_da_pdf_a_HTML.Pages.Utenti.DetailsModel

@{
    ViewData["Title"] = "Details";
    TimeSpan range = new TimeSpan();
}

<div>
    <div class="table-container" style="border:none; margin-top: 100px; margin-bottom: 50px;">
        <center>
            <h1>Dettagli Utente</h1>
            <br>
        </center>
        <div class="table-row heading">
            <div class="row-item">@Html.DisplayNameFor(model => model.Utente.Nome)</div>
            <div class="row-item">@Html.DisplayNameFor(model => model.Utente.Cognome)</div>
            <div class="row-item">Data Nascita</div>
            <div class="row-item">Numero Documento</div>
            <div class="row-item"> Data Inserimento</div>
            <div class="row-item">Data Modifica</div>
        </div>
        <div class="table-row">
            <div class="row-item">@Html.DisplayFor(model => model.Utente.Nome)</div>
            <div class="row-item">@Html.DisplayFor(model => model.Utente.Cognome)</div>
            <div class="row-item">@Html.DisplayFor(model => model.Utente.DataNascita)</div>
            <div class="row-item">@Html.DisplayFor(model => model.Utente.DocumentoUtente.Numero)</div>
            <div class="row-item">@Html.DisplayFor(model => model.Utente.DataInserimento)</div>
            <div class="row-item">@Html.DisplayFor(model => model.Utente.DataModifica)</div>
        </div>
    </div>
</div>

@if (@Model.PrestitiAttivi.Any() == true)
{
    <div class="table-container" style="border:none;">
        <center>
            <h1>Prestiti Attivi</h1>
        </center>
        <br>
        <div class="table-row heading">
            <div class="row-item">Data Inizio Prestito</div>
            <div class="row-item">Data Scadenza Prestito</div>
            <div class="row-item">Libro</div>
            <div class="row-item">Stato</div>
        </div>
        @foreach (var item in Model.PrestitiAttivi)
        {
            <div class="table-row">
                <div class="row-item">@item.DataInizioPrestito.ToString("dd/MM/yyyy")</div>
                <div class="row-item">@item.DataScadenzaPrestito.ToString("dd/MM/yyyy")</div>
                <div class="row-item">@Html.DisplayFor(modelItem => item.Libro.Titolo)</div>
                @{range = item.DataScadenzaPrestito - DateTime.Today;}

                @if (range.Days <= 0)
                {
                    <div class="row-item">Scaduto</div>
                }
                else if (range.Days > 7 && item.Eliminato == false)
                {
                    <div class="row-item">Da ritirare</div>
                }
                else
                {
                    <div class="row-item">Attivo</div>
                }
            </div>
        }
    </div>
}
else
{
    <div class="table-container" style="border:none;">
        <center>
            <h1>Prestiti Attivi</h1>
        </center>
        <br>
        <div class="table-row heading">
            <div class="row-item">Data Inizio Prestito</div>
            <div class="row-item">Data Scadenza Prestito</div>
            <div class="row-item">Data Inserimento</div>
            <div class="row-item">Data Modifica</div>
            <div class="row-item">Libro</div>
            <div class="row-item">Stato</div>
        </div>
        <div class="table-row">
            <div class="row-item">
                <h4>Nessun Prestito disponibile</h4>
            </div>
        </div>
    </div>
}

@if (@Model.Storico.Any() == true)
{
    <div class="table-container" style="border:none;">
        <br>
        <center>
            <h1>Storico Prestiti</h1>
        </center>
        <br>
        <div class="table-row heading">
            <div class="row-item">Data Inizio Prestito</div>
            <div class="row-item">Data Scadenza Prestito</div>
            <div class="row-item">Libro</div>
            <div class="row-item">Stato</div>
        </div>
        @foreach (var item in Model.Storico)
        {
            <div class="table-row">
                <div class="row-item">@item.DataInizioPrestito.ToString("dd/MM/yyyy")</div>
                <div class="row-item">@item.DataScadenzaPrestito.ToString("dd/MM/yyyy")</div>
                <div class="row-item">@Html.DisplayFor(modelItem => item.Libro.Titolo)</div>
                <div class="row-item">Consegnato</div>
            </div>
        }
    </div>
}
else
{
    <div class="table-container" style="border:none;">
        <br>
        <center>
            <h1>Storico Prestiti</h1>
        </center>
        <br>
        <div class="table-row heading">
            <div class="row-item">Data Inizio Prestito</div>
            <div class="row-item">Data Scadenza Prestito</div>
            <div class="row-item">Data Inserimento</div>
            <div class="row-item">Data Modifica</div>
            <div class="row-item">Libro</div>
            <div class="row-item">Stato</div>
        </div>
        <div class="table-row">
            <div class="row-item">
                <h4>Nessun Prestito disponibile nello storico</h4>
            </div>
        </div>
    </div>
}
<br><br>
<div>
    <a asp-page="./Edit" asp-route-id="@Model.Utente.Id">Edit</a> |
    <a asp-page="./Index">Back to List</a>
</div>
