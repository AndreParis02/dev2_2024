@page
@model Template_da_pdf_a_HTML.Pages.Utenti.IndexModel

@{
    ViewData["Title"] = "Lista Utenti";
}

<center>
    <h1 style="margin-top: 5%;">@ViewData["Title"]</h1>
</center>

<div class="main-container" style="border-radius: 10%;">


@if (@Model.Utente.Any() == true)
{
        <div class="table-container" style="border:none;">
            <p>
                <a href="/Utenti/Create">Aggiungi Utente</a>
            </p>

            <div class="table-row heading">
                <div class="row-item">@Html.DisplayNameFor(model => model.Utente[0].Nome)</div>
                <div class="row-item">@Html.DisplayNameFor(model => model.Utente[0].Cognome)</div>
                <div class="row-item">Data Nascita</div>
                <div class="row-item">Numero Documento</div>
                <div class="row-item">Data Modifica</div>
                <div class="row-item">Actions</div>
            </div>
            @foreach (var item in Model.Utente)
            {
                <div class="table-row">
                    <div class="row-item">@Html.DisplayFor(modelItem => item.Nome)</div>
                    <div class="row-item">@Html.DisplayFor(modelItem => item.Cognome)</div>
                    <div class="row-item">@Html.DisplayFor(modelItem => item.DataNascita)</div>
                    @if(item.DocumentoUtente == null)
                    {
                        <div class="row-item"><a asp-page="/DocumentiUtenti/Associa_Documento" asp-route-id="@item.Id">Associa Documento</a></div>
                    }
                    else
                    {
                        <div class="row-item">@Html.DisplayFor(modelItem => item.DocumentoUtente.Numero)</div>
                    }

                    <div class="row-item">@Html.DisplayFor(modelItem => item.DataModifica)</div>
                    <div class="row-item">
                        <div class="btn-group mt-auto">
                            <button type="button" class="btn" id="btn-details">
                                 <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> |
                        <a asp-page="./Details" asp-route-id="@item.Id">Details</a> |
                        <a asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
}
else
    {
        <div class="table-container" style="border:none;" id="inserimento-genere">
            <p>
                <a href="/Utenti/Create">Aggiungi Utente</a>
            </p>
          
            <div class="table-row heading">
                <div class="row-item">@Html.DisplayNameFor(model => model.Utente[0].Nome)</div>
                <div class="row-item">@Html.DisplayNameFor(model => model.Utente[0].Cognome)</div>
                <div class="row-item">Data Nascita</div>
                <div class="row-item">Numero Documento</div>
                <div class="row-item">Data Modifica</div>
                <div class="row-item">Actions</div>
            </div>
            <div class="table-row">
                <div class="row-item">
                    <h4>Nessun Utente disponibile</h4>
                </div>
            </div>
        </div>
    }

</div>
    <a href="/Library" class="btn btn-secondary">Torna indietro</a>
   
