@page
@model Template_da_pdf_a_HTML.Pages.DocumentiUtenti.IndexModel

@{
    ViewData["Title"] = "Lista Documenti";
}

<center>
    <h1 style="margin-top: 5%;">@ViewData["Title"]</h1>
</center>

<div class="main-container" style="border-radius: 10%;">


@if (@Model.DocumentoUtente.Any() == true)
{
        <div class="table-container" style="border:none; margin-bottom: 100px;">

            <div class="table-row heading">
                <div class="row-item">@Html.DisplayNameFor(model => model.DocumentoUtente[0].Numero)</div>
                <div class="row-item">Tipo</div>
                <div class="row-item">@Html.DisplayNameFor(model => model.DocumentoUtente[0].Utente.Nome)</div>
                <div class="row-item">@Html.DisplayNameFor(model => model.DocumentoUtente[0].Utente.Cognome)</div>
                <div class="row-item">@Html.DisplayNameFor(model => model.DocumentoUtente[0].Scadenza)</div>
                <div class="row-item">Actions</div>
            </div>
            @foreach (var item in Model.DocumentoUtente)
            {
                <div class="table-row">
                    <div class="row-item">@Html.DisplayFor(modelItem => item.Numero)</div>
                    <div class="row-item">@Html.DisplayFor(modelItem => item.Tipo.Nome)</div>
                    <div class="row-item">@Html.DisplayFor(modelItem => item.Utente.Nome)</div>
                    <div class="row-item">@Html.DisplayFor(modelItem => item.Utente.Cognome)</div>
                    <div class="row-item">@Html.DisplayFor(modelItem => item.Scadenza)</div>
                    <div class="row-item">
                        <div class="btn-group mt-auto">
                            <button type="button" class="btn" id="btn-details">
                                 <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> |
                        <a asp-page="./Details" asp-route-id="@item.Id">Details</a>
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
}
else
    {
        <div class="table-container" style="border:none;" id="inserimento-genere">
          
            <div class="table-row heading">
                 <div class="row-item">@Html.DisplayNameFor(model => model.DocumentoUtente[0].Numero)</div>
                <div class="row-item">Tipo</div>
                <div class="row-item">@Html.DisplayNameFor(model => model.DocumentoUtente[0].Utente.Nome)</div>
                <div class="row-item">@Html.DisplayNameFor(model => model.DocumentoUtente[0].Utente.Cognome)</div>
                <div class="row-item">@Html.DisplayNameFor(model => model.DocumentoUtente[0].Scadenza)</div>
                <div class="row-item">Actions</div>
            </div>
            <div class="table-row">
                <div class="row-item">
                    <h4>Nessun Documento disponibile</h4>
                </div>
            </div>
        </div>
    }

</div>
    <a href="/Library" class="btn btn-secondary">Torna indietro</a>