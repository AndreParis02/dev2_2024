@page
@model Template_da_pdf_a_HTML.Pages.Autori.IndexModel

@{
    ViewData["Title"] = "Lista Autori";
}

<center>
    <h1 style="margin-top: 5%;">@ViewData["Title"]</h1>
</center>

<div class="main-container" style="border-radius: 10%;">


@if (@Model.Autore.Any() == true)
{
        <div class="table-container" style="border:none; margin-bottom: 50px;">
            <p>
                <a asp-page="Create">Aggiungi Autore</a>
            </p>

            <div class="table-row heading">
                <div class="row-item"> @Html.DisplayNameFor(model => model.Autore[0].Nome)</div>
                <div class="row-item"> @Html.DisplayNameFor(model => model.Autore[0].Cognome)</div>
                <div class="row-item">Data Nascita</div>
                <div class="row-item">Data Morte</div>
                <div class="row-item">Actions</div>
            </div>
            @foreach (var item in Model.Autore)
            {
                <div class="table-row">
                    <div class="row-item">@Html.DisplayFor(modelItem => item.Nome)</div>
                    <div class="row-item">@Html.DisplayFor(modelItem => item.Cognome)</div>
                    <div class="row-item">@Html.DisplayFor(modelItem => item.DataNascita)</div>
                    @if (item.DataMorte != null)
                    {
                      <div class="row-item">@Html.DisplayFor(modelItem => item.DataMorte)</div>
                    }
                    else
                    {
                        <div class="row-item">in vita</div>
                    }
                    <div class="row-item">
                        <div class="btn-group mt-auto">
                            <button type="button" class="btn" id="btn-details">
                                 <a asp-page="./Edit" asp-route-id="@item.Id">Edit</a> |
                        <a asp-page="./Details" asp-route-id="@item.Id">Details</a> |
                        <a asp-page="./Delete" asp-route-id="@item.Id">Delete</a>
                            </button>
                        </div>
                    </div>
                </div>
            }
        </div>
}
else
    {
        <div class="table-container" style="border:none;">
            <p>
                <a asp-page="Create">Aggiungi Autore</a>
            </p>

            <div class="table-row heading">
                <div class="row-item">@Html.DisplayNameFor(model => model.Autore[0].Nome)</div>
                <div class="row-item">@Html.DisplayNameFor(model => model.Autore[0].Cognome)</div>
                <div class="row-item">@Html.DisplayNameFor(model => model.Autore[0].DataNascita)</div>
                <div class="row-item">@Html.DisplayNameFor(model => model.Autore[0].DataMorte)</div>
                <div class="row-item">Actions</div>
            </div>
            <div class="table-row">
                <div class="row-item">
                    <h4>Nessun Autore disponibile</h4>
                </div>
            </div>
        </div>
    }

</div>
    <a href="/Library" class="btn btn-secondary">Torna indietro</a>