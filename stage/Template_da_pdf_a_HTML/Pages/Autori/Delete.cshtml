@page
@model Template_da_pdf_a_HTML.Pages.Autori.DeleteModel

@{
    ViewData["Title"] = "Delete";
}

<h1>Delete</h1>

<h3>Are you sure you want to delete this?</h3>
<div>
    <hr />

</div>
<div class="table-container" style="border:none; margin-top: 100px; margin-bottom: 100px;">
    <div class="table-row heading">
        <div class="row-item">@Html.DisplayNameFor(model => model.Autore.Nome)</div>
         <div class="row-item">@Html.DisplayNameFor(model => model.Autore.Cognome)</div>
         <div class="row-item">Data Nascita</div>
         <div class="row-item">Data Morte</div>

    </div>
    <div class="table-row">
        <div class="row-item">@Html.DisplayFor(model => model.Autore.Nome)</div>
        <div class="row-item">@Html.DisplayFor(model => model.Autore.Cognome)</div>
        <div class="row-item">@Html.DisplayFor(model => model.Autore.DataNascita)</div>
        @if(@Model.Autore.DataMorte == null)
        {
            <div class="row-item">In vita </div>
        }
        else
        {
            <div class="row-item">@Html.DisplayFor(model => model.Autore.DataMorte)</div>
        }
    </div>
</div>

<form method="post">
    <input type="hidden" asp-for="Autore.Id" />
    <input type="submit" value="Delete" class="btn btn-danger" /> |
    <a asp-page="./Index" class="btn btn-secondary">Torna indietro</a>
</form>

