        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Richiesta.Nome)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Richiesta.Cognome)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Richiesta.Cognome)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Richiesta.Email)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Richiesta.Email)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Richiesta.Oggetto)
