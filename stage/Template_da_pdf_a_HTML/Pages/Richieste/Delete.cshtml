    <center>
        <form method="post">
            <input type="hidden" asp-for="Richiesta.Id" />
            <input type="submit" value="Delete" class="btn btn-danger" /> 
            <a asp-page="./Index" class="btn btn-primary">Torna indietro</a>
        </form>
    </center>
