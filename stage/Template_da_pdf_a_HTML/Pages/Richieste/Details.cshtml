@page
@model Template_da_pdf_a_HTML.Pages.Richieste.DetailsModel

@{
    ViewData["Title"] = "Details";
}

<center>
    <h1 style="margin-top: 5%;">@ViewData["Title"]</h1>
</center>

<div>
    <hr />
    <dl class="row">
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Richiesta.Nome)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Richiesta.Nome)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Richiesta.Cognome)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Richiesta.Cognome)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Richiesta.Email)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Richiesta.Email)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Richiesta.Oggetto)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Richiesta.Oggetto)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Richiesta.Messaggio)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Richiesta.Messaggio)
        </dd>
        <dt class="col-sm-2">
            @Html.DisplayNameFor(model => model.Richiesta.Data_inserimento)
        </dt>
        <dd class="col-sm-10">
            @Html.DisplayFor(model => model.Richiesta.Data_inserimento)
        </dd>
    </dl>
</div>
<center>
    <div>
        <button type="button" class="btn btn-primary">
            <a asp-page="./Edit" asp-route-id="@Model.Richiesta.Id"
                style="text-decoration: none; color: white;">Edit</a>
        </button> 
        <button type="button" class="btn btn-danger">
            <a asp-page="./Delete" asp-route-id="@Model.Richiesta.Id"
                style="text-decoration: none; color: white;">Delete</a>
        </button>
    </div>
</center>

<hr />

<div>
    <a asp-page="./Index" class="btn btn-secondary">Torna indietro</a>
</div>
