@page
@model Template_da_pdf_a_HTML.Pages_Prestiti.DetailsModel

@{
    ViewData["Title"] = "Details";
}

<div>
        <div class="table-container" style="border:none; margin-top: 100px; margin-bottom: 120px;">
        <center>
            <h1>Dettagli Prestito</h1>
            <br>
        </center>
        <div class="table-row heading">
            <div class="row-item">Inizio Prestito</div>
            <div class="row-item">Scadenza Prestito</div>
            <div class="row-item">@Html.DisplayNameFor(model => model.Prestito.Utente)</div>
            <div class="row-item"> @Html.DisplayNameFor(model => model.Prestito.Libro)</div>
            <div class="row-item"> Data Inserimento</div>
            <div class="row-item">Data Modifica</div>
        </div>
        <div class="table-row">
            <div class="row-item"> @Model.Prestito.DataInizioPrestito.ToString("dd/MM/yyyy")</div>
            <div class="row-item">@Model.Prestito.DataScadenzaPrestito.ToString("dd/MM/yyyy")</div>
            <div class="row-item">@Html.DisplayFor(model => model.Prestito.Utente.Nome) @Html.DisplayFor(model => model.Prestito.Utente.Cognome)</div>
            <div class="row-item">@Html.DisplayFor(model => model.Prestito.Libro.Titolo)</div>
            <div class="row-item">@Html.DisplayFor(model => model.Prestito.DataInserimento)</div>
            <div class="row-item">@Html.DisplayFor(model => model.Prestito.DataModifica)</div>
        </div>
    </div>
</div>
<div>
    <a href="./Index" class="btn btn-secondary">Torna indietro</a>
</div>