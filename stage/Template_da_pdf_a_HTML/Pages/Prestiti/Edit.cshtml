@page
@model Template_da_pdf_a_HTML.Pages_Prestiti.EditModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Prestito</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Prestito.Id" />
            <div class="form-group">
                
                <label asp-for="Prestito.DataInizioPrestito" class="control-label"></label>
                <input asp-for="Prestito.DataInizioPrestito" class="form-control" />
                <span asp-validation-for="Prestito.DataInizioPrestito" class="text-danger"></span>
            </div>
            <div class="form-group">
                
                <label asp-for="Prestito.DataScadenzaPrestito" class="control-label"></label>
                <input asp-for="Prestito.DataScadenzaPrestito" class="form-control" />
                <span asp-validation-for="Prestito.DataScadenzaPrestito" class="text-danger"></span>
            </div>
            <div class="form-group">
                
                <label asp-for="Prestito.DataInserimento" class="control-label"></label>
                <input asp-for="Prestito.DataInserimento" class="form-control" />
                <span asp-validation-for="Prestito.DataInserimento" class="text-danger"></span>
            </div>
            <div class="form-group">
                
                <label asp-for="Prestito.DataModifica" class="control-label"></label>
                <input asp-for="Prestito.DataModifica" class="form-control" />
                <span asp-validation-for="Prestito.DataModifica" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="Prestito.Eliminato" /> @Html.DisplayNameFor(model => model.Prestito.Eliminato)
                </label>
            </div>
            <div class="form-group">
                
                <label asp-for="Prestito.UtenteId" class="control-label"></label>
                <select asp-for="Prestito.UtenteId" class="form-control" asp-items="ViewBag.UtenteId"></select>
                <span asp-validation-for="Prestito.UtenteId" class="text-danger"></span>
            </div>
            <div class="form-group">
                
                <label asp-for="Prestito.LibroId" class="control-label"></label>
                <select asp-for="Prestito.LibroId" class="form-control" asp-items="ViewBag.LibroId"></select>
                <span asp-validation-for="Prestito.LibroId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-page="./Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
