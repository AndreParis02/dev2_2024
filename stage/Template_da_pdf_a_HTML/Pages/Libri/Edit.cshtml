@page
@model Template_da_pdf_a_HTML.Pages.Libri.EditModel

@{
    ViewData["Title"] = "Edit";
}

<h1>Edit</h1>

<h4>Libro</h4>
<hr />
<div class="row" id="inserimento-genere">
    <div class="col-md-4">
        <form method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Libro.Id" />
            <input type="hidden" asp-for="Libro.DataInserimento" />

            <div class="form-group">
                <label asp-for="Libro.Titolo" class="control-label"></label>
                <input asp-for="Libro.Titolo" class="form-control" />
                <span asp-validation-for="Libro.Titolo" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label>Genere</label>
                <select asp-for="Libro.idGenere" class="form-control" asp-items="ViewBag.idGenere">
                </select>
            </div>
            
            <div class="form-group">
                <label>Autore</label>
                <select asp-for="Libro.idAutore" class="form-control" asp-items="ViewBag.idAutore">
                </select>
            </div>

            <div class="form-group">    
                Anno Uscita
                <input type="date" asp-for="Libro.AnnoUscita" class="form-control" />
                <span asp-validation-for="Libro.AnnoUscita" class="text-danger"></span>
            </div>
            <br>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary" /> | 
                <a asp-page="./Index" class="btn btn-secondary">Torna indietro</a>
            </div>
        </form>
    </div>
</div>


@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
